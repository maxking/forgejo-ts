{
  "name": "forgejo-ts",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the Forgejo REST API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://git.araj.me/maxking/forgejo-ts.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "jest --testPathIgnorePatterns='live'",
    "test:watch": "jest --watch --testPathIgnorePatterns='live'",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='live'",
    "test:live": "jest --testPathPattern='live'",
    "prepare": "tsc --version >/dev/null 2>&1 && npm run build || true",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
