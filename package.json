{
  "name": "forgejo-ts",
  "version": "0.4.1",
  "description": "Zero-dependency TypeScript client for the Forgejo REST API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxking/forgejo-ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --testPathIgnorePatterns='live'",
    "test:watch": "jest --watch --testPathIgnorePatterns='live'",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='live'",
    "test:live": "jest --testPathPattern='live'",
    "prepare": "tsc --version >/dev/null 2>&1 && npm run build || true",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "minimatch": "^3.1.4"
  }
}
